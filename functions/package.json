{
  "name": "candoni-accounting-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Functions backend for the Municipal Government of Candoni Accounting System (Firebase edition).",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "lint": "node --check index.js",
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1"
  }
}
